{
  "name": "maosizhi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "desktop:package": "npm run build && npm run build:service && node scripts/desktop/package.mjs",
    "desktop:test": "vitest run services/analysis-service/test/desktopPackage.test.ts",
    "start:local": "node scripts/local-postgres.mjs personal-app",
    "verify:personal:local": "node scripts/local-postgres.mjs personal-check",
    "verify:personal:provider:local": "node scripts/local-postgres.mjs personal-provider-check",
    "verify:personal:learning:local": "node scripts/local-postgres.mjs personal-learning-check",
    "db:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local-postgres.ps1",
    "db:setup": "node scripts/local-postgres.mjs setup",
    "db:start": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:status": "node scripts/local-postgres.mjs status",
    "db:test": "node scripts/local-postgres.mjs test",
    "db:verify": "node scripts/local-postgres.mjs verify",
    "db:backup": "node scripts/local-postgres.mjs backup",
    "dev:service:local": "node scripts/local-postgres.mjs service",
    "dev:analysis:local": "node scripts/local-postgres.mjs app",
    "verify:analysis:local": "node scripts/local-postgres.mjs app-check",
    "e2e:analysis:local": "node scripts/local-postgres.mjs browser",
    "e2e:personal:local": "node scripts/local-postgres.mjs personal-browser",
    "build:browser-harness": "npm run build:contracts && tsc -p services/analysis-service/tsconfig.browser-test.json",
    "e2e:analysis": "node scripts/run-analysis-browser-tests.mjs",
    "e2e:personal": "node scripts/run-analysis-browser-tests.mjs --personal",
    "dev": "npm run build:contracts && vite",
    "typecheck:app": "tsc --noEmit",
    "typecheck": "npm run build:contracts && npm run typecheck:app",
    "typecheck:service": "npm run build:contracts && npm run typecheck --workspace @cat-thinking/analysis-service",
    "build:contracts": "npm run build --workspace @cat-thinking/analysis-contracts",
    "build:service": "npm run build:contracts && npm run build --workspace @cat-thinking/analysis-service && node scripts/write-analysis-build.mjs",
    "build": "npm run build:contracts && npm run typecheck:app && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "lint:contracts": "eslint packages/analysis-contracts/src packages/analysis-contracts/test evals/analysis",
    "lint:foundation": "eslint src/analysis packages/analysis-contracts/src packages/analysis-contracts/test services/analysis-service/src services/analysis-service/test evals/analysis scripts",
    "test": "npm run build:contracts && vitest run",
    "test:contracts": "vitest run packages/analysis-contracts/test evals/analysis",
    "test:service": "npm run build:contracts && vitest run services/analysis-service/test",
    "test:service:postgres": "npm run build:contracts && vitest run services/analysis-service/test/postgresJobStore.integration.test.ts services/analysis-service/test/targetValidation.postgres.integration.test.ts services/analysis-service/test/personalProvider.postgres.integration.test.ts services/analysis-service/test/dispatcherCompatibility.postgres.integration.test.ts --no-file-parallelism --reporter=verbose",
    "test:provider:live": "node scripts/run-live-provider-smoke.mjs",
    "test:provider:target": "node scripts/run-target-provider-validation.mjs",
    "verify:ci:sign": "node scripts/sign-analysis-ci-prerequisites.mjs",
    "prepare:provider": "node scripts/prepare-analysis-provider.mjs",
    "prepare:provider:local": "node scripts/local-postgres.mjs prepare-provider",
    "verify:browser:build": "node scripts/verify-browser-build.mjs",
    "e2e:performance": "node scripts/verify-browser-build.mjs && playwright test --config=playwright.performance.config.ts",
    "verify:container": "node scripts/verify-analysis-container.mjs",
    "coverage:postgres": "npm run build:contracts && vitest run --config vitest.postgres.config.ts --coverage && node scripts/verify-postgres-coverage.mjs",
    "typecheck:contracts": "tsc -p packages/analysis-contracts/tsconfig.json --noEmit",
    "check:contracts": "npm run typecheck:contracts && npm run test:contracts && npm run lint:contracts",
    "test:watch": "vitest",
    "coverage": "npm run build:contracts && vitest run --coverage",
    "coverage:check": "npm run coverage && node scripts/verify-coverage.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "verify:docx-render": "node scripts/verify-docx-render.mjs",
    "audit:all": "npm audit --audit-level=low",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "check:ci": "npm run lint:ci && npm run lint:foundation -- --max-warnings 0 && npm run typecheck:contracts && npm run typecheck:service && npm run coverage:check && npm run build && npm run verify:browser:build && npm run build:service && npm run verify:fixtures",
    "e2e": "npm run build:contracts && playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@cat-thinking/analysis-contracts": "0.1.0",
    "dexie": "^4.0.8",
    "fflate": "0.8.3",
    "pdfjs-dist": "4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "20.14.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.1",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
