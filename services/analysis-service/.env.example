NODE_ENV=production
ANALYSIS_HOST=0.0.0.0
ANALYSIS_PORT=8787
ANALYSIS_LOG_LEVEL=info
ANALYSIS_AUTH_MODE=service-token
ANALYSIS_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
ANALYSIS_CORS_ORIGINS=https://app.example.com
ANALYSIS_TRUST_PROXY_HOPS=1
ANALYSIS_RATE_LIMIT_MAX=60
ANALYSIS_RATE_LIMIT_WINDOW_MS=60000
ANALYSIS_BODY_LIMIT_BYTES=2100000
ANALYSIS_REQUEST_TIMEOUT_MS=30000
ANALYSIS_CONNECTION_TIMEOUT_MS=10000
ANALYSIS_KEEP_ALIVE_TIMEOUT_MS=5000
ANALYSIS_SHUTDOWN_TIMEOUT_MS=10000
ANALYSIS_RETENTION_SECONDS=3600
ANALYSIS_ENABLE_REQUEST_LOGS=true
