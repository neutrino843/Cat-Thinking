NODE_ENV=production
ANALYSIS_HOST=0.0.0.0
ANALYSIS_PORT=8787
ANALYSIS_LOG_LEVEL=info
ANALYSIS_AUTH_MODE=service-token
ANALYSIS_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
ANALYSIS_CORS_ORIGINS=https://app.example.com
ANALYSIS_TRUST_PROXY_HOPS=1
ANALYSIS_RATE_LIMIT_MAX=60
ANALYSIS_RATE_LIMIT_WINDOW_MS=60000
ANALYSIS_BODY_LIMIT_BYTES=2100000
ANALYSIS_REQUEST_TIMEOUT_MS=30000
ANALYSIS_CONNECTION_TIMEOUT_MS=10000
ANALYSIS_KEEP_ALIVE_TIMEOUT_MS=5000
ANALYSIS_SHUTDOWN_TIMEOUT_MS=10000
ANALYSIS_RETENTION_SECONDS=3600
ANALYSIS_ENABLE_REQUEST_LOGS=true
ANALYSIS_JOB_STORE=postgres
ANALYSIS_DATABASE_URL=postgresql://analysis_user:replace-me@postgres:5432/cat_analysis
ANALYSIS_DATABASE_SSL=require
ANALYSIS_CONTENT_ENCRYPTION_KEY=replace-with-canonical-base64-32-byte-key=
ANALYSIS_DB_POOL_MAX=10
ANALYSIS_DB_CONNECT_TIMEOUT_MS=10000
ANALYSIS_SSE_HEARTBEAT_MS=15000
ANALYSIS_SSE_POLL_MS=1000
ANALYSIS_LEASE_MS=30000
ANALYSIS_CLEANUP_BATCH_SIZE=100
ANALYSIS_CLEANUP_INTERVAL_MS=60000
# Keep disabled until an approved endpoint, model, and secret are supplied.
ANALYSIS_PROVIDER_MODE=disabled
# ANALYSIS_PROVIDER_ID=approved-provider
# ANALYSIS_PROVIDER_BASE_URL=https://models.example.com/v1
# ANALYSIS_PROVIDER_ALLOWED_HOSTS=models.example.com
# ANALYSIS_PROVIDER_API_KEY=replace-with-secret-manager-value
# ANALYSIS_PROVIDER_API_STYLE=responses
# ANALYSIS_PROVIDER_MODEL_ID=approved-model-snapshot
# ANALYSIS_PROVIDER_PROFILE_VERSION=profile-v1
# ANALYSIS_PROVIDER_TIMEOUT_MS=60000
# ANALYSIS_PROVIDER_MAX_INPUT_CHARACTERS=200000
# ANALYSIS_PROVIDER_MAX_OUTPUT_TOKENS=16384
# ANALYSIS_PROVIDER_MAX_RESPONSE_BYTES=2000000
